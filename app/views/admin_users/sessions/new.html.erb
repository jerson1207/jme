<section class="min-h-screen bg-gray-900 text-white flex items-center justify-center">
  <div class="w-full max-w-md px-6">
    <div class="bg-gray-800 rounded-xl shadow-xl p-8">

      <h1 class="text-3xl font-extrabold text-center">
        Admin Login
      </h1>

      <p class="mt-3 text-center text-gray-300 text-sm">
        Secure access to JME Auto Repair dashboard
      </p>

      <% if flash[:alert] %>
        <div class="mt-4 rounded-md bg-red-900/40 border border-red-700 px-4 py-3 text-sm text-red-200">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-5" }) do |f| %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-300" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                required: true,
                class: "mt-1 w-full rounded-lg bg-gray-900 border border-gray-700 px-4 py-2 text-white placeholder-gray-500 focus:border-red-600 focus:ring-red-600" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-300" %>
          <%= f.password_field :password,
                autocomplete: "current-password",
                required: true,
                class: "mt-1 w-full rounded-lg bg-gray-900 border border-gray-700 px-4 py-2 text-white placeholder-gray-500 focus:border-red-600 focus:ring-red-600" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me,
                  class: "h-4 w-4 rounded border-gray-600 bg-gray-900 text-red-600 focus:ring-red-600" %>
            <%= f.label :remember_me, class: "ml-2 text-sm text-gray-300" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Log in",
                class: "w-full bg-red-600 hover:bg-red-700 transition py-3 rounded-lg font-semibold text-white" %>
        </div>

      <% end %>

      <div class="mt-6 text-center text-sm text-gray-400">
        <%= render "admin_users/shared/links" %>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-gray-500">
      © <%= Time.current.year %> JME Auto Repair. Authorized personnel only.
    </p>
  </div>
</section>
