<% content_for :header do %>
  <%= render "shared/public_header" %>
<% end %>
<!-- HERO -->
<section class="bg-gray-900 text-white">
  <div class="container mx-auto px-6 py-24 text-center">

    <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
      Reliable Auto Repair You Can Trust
    </h1>

    <p class="mt-6 max-w-2xl mx-auto text-gray-300 text-lg">
      JME Auto Repair provides professional engine diagnostics, brake repair,
      oil change, and full vehicle maintenance.
    </p>

    <div class="mt-10 flex justify-center gap-4" data-controller="quote-modal">
      <button type="button" data-action="click->quote-modal#open"
        class="bg-red-600 hover:bg-red-700 px-8 py-3 rounded-lg font-semibold">
        Request a Quote
      </button>

      <button class="border border-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-gray-900">
        View Services
      </button>
    </div>

  </div>
</section>

<!-- TRUST -->


<section class="bg-white py-14">
  <div class="container mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
    <div>
      <p class="text-3xl font-bold text-red-600">10+</p>
      <p class="mt-2 text-gray-600">Years Experience</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-red-600">1,000+</p>
      <p class="mt-2 text-gray-600">Cars Serviced</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-red-600">Certified</p>
      <p class="mt-2 text-gray-600">Expert Mechanics</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-red-600">Warranty</p>
      <p class="mt-2 text-gray-600">Quality Guaranteed</p>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="bg-gray-100 py-20">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-12">
      Our Core Services
    </h2>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="text-xl font-semibold mb-2">Engine Diagnostics</h3>
        <p class="text-gray-600">
          Advanced tools to quickly identify engine and performance issues.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="text-xl font-semibold mb-2">Brake Repair</h3>
        <p class="text-gray-600">
          Inspection, repair, and replacement for safe driving.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="text-xl font-semibold mb-2">Oil Change</h3>
        <p class="text-gray-600">
          Fast and affordable oil service to protect your engine.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="bg-white py-20">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-12">
      How It Works
    </h2>

    <div class="grid md:grid-cols-4 gap-8 text-center">
      <div>
        <span class="text-4xl font-bold text-red-600">1</span>
        <p class="mt-2 font-semibold">Request a Quote</p>
      </div>
      <div>
        <span class="text-4xl font-bold text-red-600">2</span>
        <p class="mt-2 font-semibold">Vehicle Inspection</p>
      </div>
      <div>
        <span class="text-4xl font-bold text-red-600">3</span>
        <p class="mt-2 font-semibold">Approve Repair</p>
      </div>
      <div>
        <span class="text-4xl font-bold text-red-600">4</span>
        <p class="mt-2 font-semibold">Drive Safely</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-red-600 text-white py-16">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold">
      Need Your Car Fixed Today?
    </h2>
    <p class="mt-4 text-lg">
      Get a fast and honest quote from our expert mechanics.
    </p>

    <a
      href="#"
      class="inline-block mt-6 bg-white text-red-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100"
    >
      Request a Quote
    </a>
  </div>
</section>
