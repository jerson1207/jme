
<div id="quote_form" class="bg-white border border-gray-200 p-6 rounded-lg shadow-sm text-center">
  <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
    <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
    </svg>
  </div>

  <h3 class="text-lg font-bold text-gray-900 mb-2">Quote Request Sent</h3>
  
  <p class="text-gray-600 mb-6">
    Reference .... We’ve sent a confirmation to <strong>...</strong>. 
    A service advisor will contact you shortly.
  </p>

  <div class="border-t pt-6">
    <button type="button" 
            data-action="click->quote-modal#remove"
            class="inline-block w-full sm:w-32 bg-gray-900 hover:bg-black text-white font-medium py-2.5 px-5 rounded-md transition-colors">
      OK
    </button>
  </div>
</div>