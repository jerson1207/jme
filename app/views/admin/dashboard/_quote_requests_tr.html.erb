<tr id="<%= dom_id(quote_request) %>">
  <td class="px-6 py-4 whitespace-nowrap"><%= quote_request.id %></td>
  <td class="px-6 py-4 whitespace-nowrap"><%= quote_request.full_name %></td>
  <td class="px-6 py-4 whitespace-nowrap"><%= quote_request.email %></td>
  <td class="px-6 py-4 whitespace-nowrap"><%= quote_request.phone %></td>
  <td class="px-6 py-4 whitespace-nowrap"><%= quote_request.vehicle_make %></td>
  <td class="px-6 py-4 whitespace-nowrap">
    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
      Completed
    </span>
  </td>
  <td class="px-6 py-4 whitespace-nowrap"><%= quote_request.created_at.strftime("%Y-%m-%d") %></td>
</tr>
